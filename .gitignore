__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Simulator work dirs and console logs: regenerable, and large. The convention
# is heteropilot's -- results are committed, the runs that produced them are not.
outputs/
experiments/results/**/work/
*.stdout
*.stderr
# Tool configuration is committed to neither repository (CLAUDE.md, "The
# boundary"). Editor and agent settings live in a global gitignore; these are
# named here too so a stray `git add .` cannot repeat heteropilot #132/#133.
.mcp.json
.ignore
.claude/
.cursor/
.vscode/
.idea/
graft/
